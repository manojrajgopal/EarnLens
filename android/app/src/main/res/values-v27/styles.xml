<?xml version="1.0" encoding="utf-8"?>
<!-- API 27+: let the window extend into display cutouts (notches, punch-holes)
     on the short edges. Flutter reports the cutout as MediaQuery padding, and
     EarnLens keeps interactive content inside it (AppBar / SafeArea / AppInsets). -->
<resources>
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
