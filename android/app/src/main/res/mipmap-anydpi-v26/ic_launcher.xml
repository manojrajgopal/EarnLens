<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). Foreground: the supplied EarnLens icon
     (assets/images/earnlens_app_icon.png) scaled into the safe zone. Background:
     the icon tile's own colour so any launcher mask shape looks seamless. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
